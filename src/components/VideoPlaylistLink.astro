---
interface Props {
  href: string;
  title: string;
  label?: string;
}

const { href, title, label = "Playlist du concert" } = Astro.props;
---

<div class="group">
  <div class="icon">
    <i class="fab fa-youtube"></i>
  </div>
  <div>
    <a href={href} target="_blank" class="event-link" title={title}>{label}</a>
  </div>
</div>
