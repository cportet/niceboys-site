---
const navItems = [
  { href: "/", label: "Accueil" },
  { href: "/groupe", label: "Le groupe & booking" },
  { href: "/soutien", label: "Soutenez-nous" },
  { href: "/mentions", label: "Mentions légales" }
];

const normalizePath = (path: string) => (path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path);
const currentPath = normalizePath(Astro.url.pathname);
---

<nav class="site-nav" aria-label="Navigation principale">
  <div class="container">
    <ul class="site-nav__list" role="list">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <li>
              <a href={item.href} class:list={["site-nav__link", { "is-active": isActive }]} aria-current={isActive ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <details class="site-nav__mobile">
      <summary class="site-nav__toggle">
        <i class="fa-solid fa-bars" aria-hidden="true"></i> Menu
      </summary>
      <ul class="site-nav__mobile-list" role="list">
        {
          navItems.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <li>
                <a href={item.href} class:list={["site-nav__mobile-link", { "is-active": isActive }]} aria-current={isActive ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </details>
  </div>
</nav>
